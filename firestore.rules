rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net (Default-Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Primitive Helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && (
        request.auth.token.email_verified == true ||
        ('phone_number' in request.auth.token && request.auth.token.phone_number != null)
      );
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isBootstrappedAdmin() {
      return isVerifiedUser() && (
        request.auth.token.email == 'wahbi.rachid@gmail.com' ||
        ('email' in request.auth.token && request.auth.token.email is string && request.auth.token.email.lower() == 'wahbi.rachid@gmail.com')
      );
    }

    function isAdmin() {
      return (isVerifiedUser() && request.auth.token.admin == true) ||
        isBootstrappedAdmin() || (
          isVerifiedUser() && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        );
    }

    function isValidCity(city) {
      return city is string && city.size() <= 32 && (
        city == 'Casablanca' ||
        city == 'Rabat' ||
        city == 'Marrakech' ||
        city == 'Tangier' ||
        city == 'Fes' ||
        city == 'Agadir'
      );
    }

    function isValidCategory(cat) {
      return cat is string && cat.size() <= 32 && (
        cat == 'Plomberie' ||
        cat == 'Électricité' ||
        cat == 'Peinture' ||
        cat == 'Soutien Scolaire' ||
        cat == 'Ménage' ||
        cat == 'Climatisation'
      );
    }

    function isValidSpecialty(spec) {
      return isValidCategory(spec) || spec == 'none';
    }

    function isSafeAssetUrl(url) {
      return url is string && url.size() >= 1 && url.size() <= 2048 && (
        url.matches('^https://.*') ||
        url.matches('^/src/assets/images/[a-zA-Z0-9_.\\-]+$')
      );
    }

    function isValidSkillList(skills) {
      return skills is list && skills.size() >= 1 && skills.size() <= 10 &&
        (skills.size() < 1 || (skills[0] is string && skills[0].size() >= 1 && skills[0].size() <= 64)) &&
        (skills.size() < 2 || (skills[1] is string && skills[1].size() >= 1 && skills[1].size() <= 64)) &&
        (skills.size() < 3 || (skills[2] is string && skills[2].size() >= 1 && skills[2].size() <= 64)) &&
        (skills.size() < 4 || (skills[3] is string && skills[3].size() >= 1 && skills[3].size() <= 64)) &&
        (skills.size() < 5 || (skills[4] is string && skills[4].size() >= 1 && skills[4].size() <= 64)) &&
        (skills.size() < 6 || (skills[5] is string && skills[5].size() >= 1 && skills[5].size() <= 64)) &&
        (skills.size() < 7 || (skills[6] is string && skills[6].size() >= 1 && skills[6].size() <= 64)) &&
        (skills.size() < 8 || (skills[7] is string && skills[7].size() >= 1 && skills[7].size() <= 64)) &&
        (skills.size() < 9 || (skills[8] is string && skills[8].size() >= 1 && skills[8].size() <= 64)) &&
        (skills.size() < 10 || (skills[9] is string && skills[9].size() >= 1 && skills[9].size() <= 64));
    }

    function isValidPortfolioList(images) {
      return images is list && images.size() >= 1 && images.size() <= 6 &&
        (images.size() < 1 || isSafeAssetUrl(images[0])) &&
        (images.size() < 2 || isSafeAssetUrl(images[1])) &&
        (images.size() < 3 || isSafeAssetUrl(images[2])) &&
        (images.size() < 4 || isSafeAssetUrl(images[3])) &&
        (images.size() < 5 || isSafeAssetUrl(images[4])) &&
        (images.size() < 6 || isSafeAssetUrl(images[5]));
    }

    function getConfiguredPlatformFeePct() {
      return exists(/databases/$(database)/documents/systemSettings/global)
        ? get(/databases/$(database)/documents/systemSettings/global).data.platformFeePct
        : 10;
    }

    function isValidLocationMap(loc) {
      return loc is map &&
        loc.keys().hasAll(['lat', 'lng', 'city', 'quartier']) &&
        loc.keys().hasOnly(['lat', 'lng', 'city', 'quartier']) &&
        loc.lat is number && loc.lat >= 20 && loc.lat <= 37 &&
        loc.lng is number && loc.lng >= -18 && loc.lng <= -1 &&
        isValidCity(loc.city) &&
        loc.quartier is string && loc.quartier.size() >= 2 && loc.quartier.size() <= 80;
    }

    // 3. Validation Blueprint: UserProfile (/users/{uid})
    function isValidUserProfile(data) {
      return data.keys().hasAll([
          'uid',
          'role',
          'fullName',
          'phone',
          'city',
          'neighborhood',
          'languagePref',
          'verifiedBadge',
          'createdAt'
        ]) &&
        data.keys().hasOnly([
          'uid',
          'role',
          'fullName',
          'phone',
          'city',
          'neighborhood',
          'languagePref',
          'verifiedBadge',
          'specialty',
          'hourlyRateMad',
          'bio',
          'createdAt',
          'updatedAt'
        ]) &&
        data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128 && data.uid.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.role is string && data.role.size() <= 16 && (
          data.role == 'client' ||
          data.role == 'provider' ||
          data.role == 'both'
        ) &&
        data.fullName is string && data.fullName.size() >= 2 && data.fullName.size() <= 80 &&
        data.phone is string && data.phone.size() >= 12 && data.phone.size() <= 16 && data.phone.matches('^\\+212[5-7][0-9]{8}$') &&
        isValidCity(data.city) &&
        data.neighborhood is string && data.neighborhood.size() >= 2 && data.neighborhood.size() <= 80 &&
        data.languagePref is string && data.languagePref.size() == 2 && (data.languagePref == 'fr' || data.languagePref == 'ar') &&
        data.verifiedBadge is bool &&
        data.createdAt is timestamp &&
        (!('specialty' in data) || isValidSpecialty(data.specialty)) &&
        (!('hourlyRateMad' in data) || (data.hourlyRateMad is int && data.hourlyRateMad >= 0 && data.hourlyRateMad <= 50000)) &&
        (!('bio' in data) || (data.bio is string && data.bio.size() <= 500)) &&
        (!('updatedAt' in data) || data.updatedAt is timestamp);
    }

    // 4. Validation Blueprint: ProviderProfile (/providers/{uid})
    function isValidProviderProfile(data) {
      return data.keys().hasAll([
          'uid',
          'fullNameFr',
          'fullNameAr',
          'category',
          'bioFr',
          'bioAr',
          'hourlyRateMAD',
          'fixedVisitFeeMAD',
          'experienceYears',
          'skills',
          'portfolioImages',
          'ratingAvg',
          'reviewCount',
          'isAvailableNow',
          'verifiedBadge',
          'location',
          'createdAt',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'uid',
          'fullNameFr',
          'fullNameAr',
          'category',
          'bioFr',
          'bioAr',
          'hourlyRateMAD',
          'fixedVisitFeeMAD',
          'experienceYears',
          'skills',
          'portfolioImages',
          'ratingAvg',
          'reviewCount',
          'isAvailableNow',
          'verifiedBadge',
          'phone',
          'completedJobs',
          'lastCompletedBookingId',
          'lastReviewBookingId',
          'location',
          'createdAt',
          'updatedAt'
        ]) &&
        data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128 && data.uid.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.fullNameFr is string && data.fullNameFr.size() >= 2 && data.fullNameFr.size() <= 80 &&
        data.fullNameAr is string && data.fullNameAr.size() >= 2 && data.fullNameAr.size() <= 80 &&
        isValidCategory(data.category) &&
        data.bioFr is string && data.bioFr.size() >= 10 && data.bioFr.size() <= 600 &&
        data.bioAr is string && data.bioAr.size() >= 10 && data.bioAr.size() <= 600 &&
        data.hourlyRateMAD is int && data.hourlyRateMAD >= 50 && data.hourlyRateMAD <= 50000 &&
        data.fixedVisitFeeMAD is int && data.fixedVisitFeeMAD >= 0 && data.fixedVisitFeeMAD <= 10000 &&
        data.experienceYears is int && data.experienceYears >= 0 && data.experienceYears <= 60 &&
        isValidSkillList(data.skills) &&
        isValidPortfolioList(data.portfolioImages) &&
        data.ratingAvg is number && data.ratingAvg >= 0 && data.ratingAvg <= 5 &&
        data.reviewCount is int && data.reviewCount >= 0 && data.reviewCount <= 100000 &&
        data.isAvailableNow is bool &&
        data.verifiedBadge is bool &&
        (!('phone' in data) || (data.phone is string && data.phone.size() >= 12 && data.phone.size() <= 16 && data.phone.matches('^\\+212[5-7][0-9]{8}$'))) &&
        (!('completedJobs' in data) || (data.completedJobs is int && data.completedJobs >= 0 && data.completedJobs <= 100000)) &&
        (!('lastCompletedBookingId' in data) || (data.lastCompletedBookingId is string && data.lastCompletedBookingId.size() >= 1 && data.lastCompletedBookingId.size() <= 128 && data.lastCompletedBookingId.matches('^[a-zA-Z0-9_\\-]+$'))) &&
        (!('lastReviewBookingId' in data) || (data.lastReviewBookingId is string && data.lastReviewBookingId.size() >= 1 && data.lastReviewBookingId.size() <= 128 && data.lastReviewBookingId.matches('^[a-zA-Z0-9_\\-]+$'))) &&
        isValidLocationMap(data.location) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    // 5. Validation Blueprint: Review (/reviews/{reviewId})
    function isValidReview(data) {
      return data.keys().hasAll([
          'bookingId',
          'providerId',
          'clientId',
          'authorName',
          'quartier',
          'rating',
          'comment',
          'createdAt'
        ]) &&
        data.keys().hasOnly([
          'bookingId',
          'providerId',
          'clientId',
          'authorName',
          'quartier',
          'rating',
          'comment',
          'createdAt'
        ]) &&
        data.bookingId is string && data.bookingId.size() >= 1 && data.bookingId.size() <= 128 && data.bookingId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.providerId is string && data.providerId.size() >= 1 && data.providerId.size() <= 128 && data.providerId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.clientId is string && data.clientId.size() >= 1 && data.clientId.size() <= 128 && data.clientId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.clientId == request.auth.uid &&
        data.authorName is string && data.authorName.size() >= 2 && data.authorName.size() <= 80 &&
        data.quartier is string && data.quartier.size() >= 2 && data.quartier.size() <= 80 &&
        data.rating is int && data.rating >= 1 && data.rating <= 5 &&
        data.comment is string && data.comment.size() >= 2 && data.comment.size() <= 500 &&
        data.createdAt is timestamp;
    }

    // 6. Validation Blueprint: Booking (/bookings/{bookingId})
    function isValidBooking(data) {
      return data.keys().hasAll([
          'bookingRef',
          'clientId',
          'clientName',
          'clientPhone',
          'providerId',
          'providerName',
          'providerPhone',
          'category',
          'serviceType',
          'city',
          'neighborhood',
          'addressPin',
          'description',
          'preferredDate',
          'preferredTimeSlot',
          'paymentMethod',
          'paymentStatus',
          'estimatedMad',
          'status',
          'createdAt',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'bookingRef',
          'clientId',
          'clientName',
          'clientPhone',
          'providerId',
          'providerName',
          'providerPhone',
          'category',
          'serviceType',
          'city',
          'neighborhood',
          'addressPin',
          'description',
          'problemPhotoUrl',
          'preferredDate',
          'preferredTimeSlot',
          'paymentMethod',
          'paymentStatus',
          'estimatedMad',
          'providerPayoutMad',
          'platformFeeMad',
          'refundedClientMad',
          'cancellationReason',
          'cancelledBy',
          'rescheduleNote',
          'status',
          'reviewRating',
          'reviewComment',
          'createdAt',
          'updatedAt'
        ]) &&
        data.bookingRef is string && data.bookingRef.size() >= 3 && data.bookingRef.size() <= 32 &&
        data.clientId is string && data.clientId.size() >= 1 && data.clientId.size() <= 128 && data.clientId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.clientName is string && data.clientName.size() >= 2 && data.clientName.size() <= 80 &&
        data.clientPhone is string && data.clientPhone.size() >= 12 && data.clientPhone.size() <= 16 && data.clientPhone.matches('^\\+212[5-7][0-9]{8}$') &&
        data.providerId is string && data.providerId.size() >= 1 && data.providerId.size() <= 128 && data.providerId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.providerName is string && data.providerName.size() >= 2 && data.providerName.size() <= 80 &&
        data.providerPhone is string && data.providerPhone.size() >= 12 && data.providerPhone.size() <= 16 && data.providerPhone.matches('^\\+212[5-7][0-9]{8}$') &&
        isValidCategory(data.category) &&
        data.serviceType is string && data.serviceType.size() >= 2 && data.serviceType.size() <= 120 &&
        isValidCity(data.city) &&
        data.neighborhood is string && data.neighborhood.size() >= 2 && data.neighborhood.size() <= 80 &&
        data.addressPin is string && data.addressPin.size() >= 2 && data.addressPin.size() <= 160 &&
        data.description is string && data.description.size() >= 10 && data.description.size() <= 600 &&
        (!('problemPhotoUrl' in data) || isSafeAssetUrl(data.problemPhotoUrl)) &&
        data.preferredDate is string && data.preferredDate.size() >= 8 && data.preferredDate.size() <= 32 &&
        data.preferredTimeSlot is string && data.preferredTimeSlot.size() <= 32 && (
          data.preferredTimeSlot == '09:00 - 12:00' ||
          data.preferredTimeSlot == '14:00 - 17:00' ||
          data.preferredTimeSlot == '18:00 - 20:00'
        ) &&
        data.paymentMethod is string && data.paymentMethod.size() <= 32 && (
          data.paymentMethod == 'cash_on_completion' ||
          data.paymentMethod == 'cmi_escrow'
        ) &&
        data.paymentStatus is string && data.paymentStatus.size() <= 32 && (
          data.paymentStatus == 'unpaid_cod' ||
          data.paymentStatus == 'escrow_held' ||
          data.paymentStatus == 'paid' ||
          data.paymentStatus == 'refunded' ||
          data.paymentStatus == 'disputed_split'
        ) &&
        data.estimatedMad is int && data.estimatedMad >= 50 && data.estimatedMad <= 100000 &&
        (!('providerPayoutMad' in data) || (data.providerPayoutMad is int && data.providerPayoutMad >= 0 && data.providerPayoutMad <= 100000)) &&
        (!('platformFeeMad' in data) || (data.platformFeeMad is int && data.platformFeeMad >= 0 && data.platformFeeMad <= 100000)) &&
        (!('refundedClientMad' in data) || (data.refundedClientMad is int && data.refundedClientMad >= 0 && data.refundedClientMad <= 100000)) &&
        (!('cancellationReason' in data) || (data.cancellationReason is string && data.cancellationReason.size() <= 400)) &&
        (!('cancelledBy' in data) || (data.cancelledBy is string && data.cancelledBy.size() <= 16 && (
          data.cancelledBy == 'client' ||
          data.cancelledBy == 'provider' ||
          data.cancelledBy == 'admin'
        ))) &&
        (!('rescheduleNote' in data) || (data.rescheduleNote is string && data.rescheduleNote.size() <= 300)) &&
        data.status is string && data.status.size() <= 24 && (
          data.status == 'pending' ||
          data.status == 'accepted' ||
          data.status == 'in_progress' ||
          data.status == 'completed' ||
          data.status == 'reviewed' ||
          data.status == 'cancelled'
        ) &&
        (!('reviewRating' in data) || (data.reviewRating is int && data.reviewRating >= 1 && data.reviewRating <= 5)) &&
        (!('reviewComment' in data) || (data.reviewComment is string && data.reviewComment.size() <= 500)) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    // 7. Validation Blueprint: ChatMessage (/chats/{bookingId}/messages/{messageId})
    function isValidChatMessage(data) {
      return data.keys().hasAll([
          'bookingId',
          'clientId',
          'providerId',
          'senderId',
          'senderName',
          'senderRole',
          'text',
          'createdAt'
        ]) &&
        data.keys().hasOnly([
          'bookingId',
          'clientId',
          'providerId',
          'senderId',
          'senderName',
          'senderRole',
          'text',
          'photoUrl',
          'createdAt'
        ]) &&
        data.bookingId is string && data.bookingId.size() >= 1 && data.bookingId.size() <= 128 && data.bookingId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.clientId is string && data.clientId.size() >= 1 && data.clientId.size() <= 128 && data.clientId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.providerId is string && data.providerId.size() >= 1 && data.providerId.size() <= 128 && data.providerId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.senderId is string && data.senderId.size() >= 1 && data.senderId.size() <= 128 && data.senderId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.senderId == request.auth.uid &&
        data.senderName is string && data.senderName.size() >= 2 && data.senderName.size() <= 80 &&
        data.senderRole is string && data.senderRole.size() <= 16 && (
          data.senderRole == 'client' ||
          data.senderRole == 'provider'
        ) &&
        data.text is string && data.text.size() >= 1 && data.text.size() <= 500 &&
        (!('photoUrl' in data) || isSafeAssetUrl(data.photoUrl)) &&
        data.createdAt is timestamp;
    }

    // 8. Validation Blueprint: AdminLog (/adminLogs/{logId})
    function isValidAdminLog(data) {
      return data.keys().hasAll([
          'adminUid',
          'adminEmail',
          'actionType',
          'targetCollection',
          'targetId',
          'summary',
          'createdAt'
        ]) &&
        data.keys().hasOnly([
          'adminUid',
          'adminEmail',
          'actionType',
          'targetCollection',
          'targetId',
          'summary',
          'createdAt'
        ]) &&
        data.adminUid is string && data.adminUid.size() >= 1 && data.adminUid.size() <= 128 && data.adminUid.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.adminUid == request.auth.uid &&
        data.adminEmail is string && data.adminEmail.size() >= 5 && data.adminEmail.size() <= 160 &&
        data.actionType is string && data.actionType.size() <= 32 && (
          data.actionType == 'cin_approved' ||
          data.actionType == 'cin_revoked' ||
          data.actionType == 'escrow_released' ||
          data.actionType == 'escrow_refunded' ||
          data.actionType == 'dispute_split' ||
          data.actionType == 'withdrawal_updated' ||
          data.actionType == 'settings_updated' ||
          data.actionType == 'booking_override' ||
          data.actionType == 'review_deleted' ||
          data.actionType == 'availability_toggled'
        ) &&
        data.targetCollection is string && data.targetCollection.size() <= 24 && (
          data.targetCollection == 'users' ||
          data.targetCollection == 'providers' ||
          data.targetCollection == 'bookings' ||
          data.targetCollection == 'reviews' ||
          data.targetCollection == 'withdrawals' ||
          data.targetCollection == 'settings'
        ) &&
        data.targetId is string && data.targetId.size() >= 1 && data.targetId.size() <= 128 && data.targetId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.summary is string && data.summary.size() >= 4 && data.summary.size() <= 300 &&
        data.createdAt is timestamp;
    }

    // 9. Validation Blueprint: WithdrawalRequest (/withdrawals/{withdrawalId})
    function isValidWithdrawal(data) {
      return data.keys().hasAll([
          'providerId',
          'providerName',
          'city',
          'bankName',
          'ribMasked',
          'amountMad',
          'status',
          'createdAt',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'providerId',
          'providerName',
          'city',
          'bankName',
          'ribMasked',
          'amountMad',
          'status',
          'adminNote',
          'createdAt',
          'updatedAt'
        ]) &&
        data.providerId is string && data.providerId.size() >= 1 && data.providerId.size() <= 128 && data.providerId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.providerName is string && data.providerName.size() >= 2 && data.providerName.size() <= 80 &&
        isValidCity(data.city) &&
        data.bankName is string && data.bankName.size() >= 2 && data.bankName.size() <= 64 &&
        data.ribMasked is string && data.ribMasked.size() >= 6 && data.ribMasked.size() <= 40 &&
        data.amountMad is int && data.amountMad >= 100 && data.amountMad <= 100000 &&
        data.status is string && data.status.size() <= 24 && (
          data.status == 'pending' ||
          data.status == 'approved' ||
          data.status == 'frozen' ||
          data.status == 'rejected'
        ) &&
        (!('adminNote' in data) || (data.adminNote is string && data.adminNote.size() <= 300)) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    // 10. Validation Blueprint: SystemSettings (/systemSettings/{configId})
    function isValidSystemSettings(data) {
      return data.keys().hasAll([
          'platformFeePct',
          'minWithdrawalMad',
          'autoRefundOnProviderCancel',
          'requireKycForEscrowPayout',
          'supportWhatsAppPhone',
          'updatedByEmail',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'platformFeePct',
          'minWithdrawalMad',
          'autoRefundOnProviderCancel',
          'requireKycForEscrowPayout',
          'supportWhatsAppPhone',
          'updatedByEmail',
          'updatedAt'
        ]) &&
        data.platformFeePct is int && data.platformFeePct >= 0 && data.platformFeePct <= 50 &&
        data.minWithdrawalMad is int && data.minWithdrawalMad >= 50 && data.minWithdrawalMad <= 20000 &&
        data.autoRefundOnProviderCancel is bool &&
        data.requireKycForEscrowPayout is bool &&
        data.supportWhatsAppPhone is string && data.supportWhatsAppPhone.size() >= 12 && data.supportWhatsAppPhone.size() <= 16 && data.supportWhatsAppPhone.matches('^\\+212[5-7][0-9]{8}$') &&
        data.updatedByEmail is string && data.updatedByEmail.size() >= 5 && data.updatedByEmail.size() <= 160 &&
        data.updatedAt is timestamp;
    }

    // 11. Match: /admins/{adminId}
    match /admins/{adminId} {
      allow get: if isVerifiedUser() && isValidId(adminId) && request.auth.uid == adminId;
      allow list, create, update, delete: if false;
    }

    // 12. Match: /users/{uid} (PII isolated to owner or verified admin; users cannot self-assign verifiedBadge)
    match /users/{uid} {
      allow get: if isSignedIn() && isValidId(uid) && (request.auth.uid == uid || isAdmin());
      allow list: if (isSignedIn() && resource.data.uid == request.auth.uid) || isAdmin();

      allow create: if isVerifiedUser() &&
        isValidId(uid) &&
        request.auth.uid == uid &&
        incoming().uid == request.auth.uid &&
        isValidUserProfile(incoming()) &&
        incoming().createdAt == request.time &&
        (!('updatedAt' in incoming()) || incoming().updatedAt == request.time) &&
        (incoming().verifiedBadge == false || isAdmin());

      allow update: if isVerifiedUser() &&
        isValidId(uid) &&
        isValidUserProfile(incoming()) &&
        incoming().uid == existing().uid &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time && (
          (
            request.auth.uid == uid &&
            incoming().verifiedBadge == existing().verifiedBadge &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'role',
              'fullName',
              'phone',
              'city',
              'neighborhood',
              'languagePref',
              'specialty',
              'hourlyRateMad',
              'bio',
              'updatedAt'
            ])
          ) ||
          isAdmin()
        );

      allow delete: if isVerifiedUser() && isValidId(uid) && isAdmin();
    }

    // 13. Match: /providers/{uid} (Anyone can read providers; owners edit own profile; clients atomically update rating via review batch; admins verify CIN)
    match /providers/{uid} {
      allow get: if isValidId(uid);
      allow list: if true;

      allow create: if isVerifiedUser() &&
        isValidId(uid) &&
        request.auth.uid == uid &&
        incoming().uid == request.auth.uid &&
        isValidProviderProfile(incoming()) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        incoming().ratingAvg == 5.0 &&
        incoming().reviewCount == 0 &&
        (!('completedJobs' in incoming()) || incoming().completedJobs == 0) &&
        !('lastCompletedBookingId' in incoming()) &&
        !('lastReviewBookingId' in incoming()) &&
        (incoming().verifiedBadge == false || isAdmin()) &&
        existsAfter(/databases/$(database)/documents/users/$(request.auth.uid));

      allow update: if isVerifiedUser() &&
        isValidId(uid) &&
        isValidProviderProfile(incoming()) &&
        incoming().uid == existing().uid &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time && (
          // Action 1: Provider updates own profile / availability (strictly request.auth.uid == uid)
          (
            request.auth.uid == uid &&
            incoming().verifiedBadge == existing().verifiedBadge &&
            incoming().ratingAvg == existing().ratingAvg &&
            incoming().reviewCount == existing().reviewCount &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'fullNameFr',
              'fullNameAr',
              'category',
              'bioFr',
              'bioAr',
              'hourlyRateMAD',
              'fixedVisitFeeMAD',
              'experienceYears',
              'skills',
              'portfolioImages',
              'isAvailableNow',
              'phone',
              'location',
              'updatedAt'
            ])
          ) ||
          // Action 1B: Provider atomically increments completedJobs inside the same batch as completing a booking
          (
            request.auth.uid == uid &&
            incoming().verifiedBadge == existing().verifiedBadge &&
            incoming().ratingAvg == existing().ratingAvg &&
            incoming().reviewCount == existing().reviewCount &&
            ('lastCompletedBookingId' in incoming()) &&
            (!('lastCompletedBookingId' in existing()) || incoming().lastCompletedBookingId != existing().lastCompletedBookingId) &&
            incoming().completedJobs == (('completedJobs' in existing()) ? existing().completedJobs : 0) + 1 &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'completedJobs',
              'lastCompletedBookingId',
              'updatedAt'
            ]) &&
            get(/databases/$(database)/documents/bookings/$(incoming().lastCompletedBookingId)).data.providerId == uid &&
            get(/databases/$(database)/documents/bookings/$(incoming().lastCompletedBookingId)).data.status == 'in_progress' &&
            getAfter(/databases/$(database)/documents/bookings/$(incoming().lastCompletedBookingId)).data.status == 'completed'
          ) ||
          // Action 2: Client atomic rating aggregation inside the same batch as creating /reviews/{bookingId}
          (
            request.auth.uid != uid &&
            incoming().verifiedBadge == existing().verifiedBadge &&
            incoming().reviewCount == existing().reviewCount + 1 &&
            incoming().ratingAvg >= 1 &&
            incoming().ratingAvg <= 5 &&
            ('lastReviewBookingId' in incoming()) &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'ratingAvg',
              'reviewCount',
              'lastReviewBookingId',
              'updatedAt'
            ]) &&
            !exists(/databases/$(database)/documents/reviews/$(incoming().lastReviewBookingId)) &&
            existsAfter(/databases/$(database)/documents/reviews/$(incoming().lastReviewBookingId)) &&
            getAfter(/databases/$(database)/documents/reviews/$(incoming().lastReviewBookingId)).data.clientId == request.auth.uid &&
            getAfter(/databases/$(database)/documents/reviews/$(incoming().lastReviewBookingId)).data.providerId == uid &&
            (
              incoming().ratingAvg * incoming().reviewCount -
              (existing().ratingAvg * existing().reviewCount + getAfter(/databases/$(database)/documents/reviews/$(incoming().lastReviewBookingId)).data.rating)
            ) >= -0.1 * incoming().reviewCount &&
            (
              incoming().ratingAvg * incoming().reviewCount -
              (existing().ratingAvg * existing().reviewCount + getAfter(/databases/$(database)/documents/reviews/$(incoming().lastReviewBookingId)).data.rating)
            ) <= 0.1 * incoming().reviewCount
          ) ||
          isAdmin()
        );

      allow delete: if isVerifiedUser() && isValidId(uid) && isAdmin();
    }

    // 14. Match: /reviews/{reviewId} (Deterministic reviewId == bookingId prevents duplicate reviews; admins can moderate/delete)
    match /reviews/{reviewId} {
      allow get: if isValidId(reviewId);
      allow list: if true;

      allow create: if isVerifiedUser() &&
        isValidId(reviewId) &&
        isValidReview(incoming()) &&
        reviewId == incoming().bookingId &&
        incoming().createdAt == request.time &&
        get(/databases/$(database)/documents/bookings/$(reviewId)).data.clientId == request.auth.uid &&
        get(/databases/$(database)/documents/bookings/$(reviewId)).data.providerId == incoming().providerId &&
        get(/databases/$(database)/documents/bookings/$(reviewId)).data.status == 'completed' &&
        getAfter(/databases/$(database)/documents/bookings/$(reviewId)).data.status == 'reviewed';

      allow update: if false;
      allow delete: if isVerifiedUser() && isValidId(reviewId) && isAdmin();
    }

    // 15. Match: /bookings/{bookingId} (Strict sequential state machine, exact escrow split invariants, auto-refund, reschedule & admin oversight)
    match /bookings/{bookingId} {
      allow get: if isVerifiedUser() &&
        isValidId(bookingId) &&
        (existing().clientId == request.auth.uid || existing().providerId == request.auth.uid || isAdmin());

      allow list: if (
        isVerifiedUser() &&
        (resource.data.clientId == request.auth.uid || resource.data.providerId == request.auth.uid)
      ) || isAdmin();

      allow create: if isVerifiedUser() &&
        isValidId(bookingId) &&
        isValidBooking(incoming()) &&
        incoming().clientId == request.auth.uid &&
        incoming().providerId != request.auth.uid &&
        incoming().status == 'pending' &&
        !('providerPayoutMad' in incoming()) &&
        !('platformFeeMad' in incoming()) &&
        !('refundedClientMad' in incoming()) &&
        !('cancellationReason' in incoming()) &&
        !('cancelledBy' in incoming()) &&
        !('reviewRating' in incoming()) &&
        !('reviewComment' in incoming()) &&
        (
          (incoming().paymentMethod == 'cmi_escrow' && incoming().paymentStatus == 'escrow_held') ||
          (incoming().paymentMethod == 'cash_on_completion' && incoming().paymentStatus == 'unpaid_cod')
        ) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        existsAfter(/databases/$(database)/documents/users/$(request.auth.uid));

      allow update: if isVerifiedUser() &&
        isValidId(bookingId) &&
        isValidBooking(incoming()) &&
        incoming().clientId == existing().clientId &&
        incoming().providerId == existing().providerId &&
        incoming().estimatedMad == existing().estimatedMad &&
        incoming().paymentMethod == existing().paymentMethod &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time && (
          isAdmin() || (
            existing().status != 'cancelled' && (
              // Action 2: Client confirms & releases held CMI escrow on completed or reviewed booking (exact fee/payout split invariant)
              (
                request.auth.uid == existing().clientId &&
                (existing().status == 'completed' || existing().status == 'reviewed') &&
                incoming().status == existing().status &&
                existing().paymentMethod == 'cmi_escrow' &&
                existing().paymentStatus == 'escrow_held' &&
                incoming().paymentStatus == 'paid' &&
                incoming().refundedClientMad == 0 &&
                incoming().providerPayoutMad + incoming().platformFeeMad == existing().estimatedMad &&
                incoming().platformFeeMad * 100 >= existing().estimatedMad * getConfiguredPlatformFeePct() - 100 &&
                incoming().platformFeeMad * 100 <= existing().estimatedMad * getConfiguredPlatformFeePct() + 100 &&
                incoming().diff(existing()).affectedKeys().hasOnly([
                  'paymentStatus',
                  'providerPayoutMad',
                  'platformFeeMad',
                  'refundedClientMad',
                  'updatedAt'
                ])
              ) || (
                existing().status != 'reviewed' && (
                  // Action 1: Client cancels pending or accepted booking (auto-refunds if CMI escrow was held)
                  (
                    request.auth.uid == existing().clientId &&
                    (existing().status == 'pending' || existing().status == 'accepted') &&
                    incoming().status == 'cancelled' &&
                    incoming().cancelledBy == 'client' &&
                    incoming().providerPayoutMad == 0 &&
                    incoming().platformFeeMad == 0 &&
                    (
                      (
                        existing().paymentMethod == 'cmi_escrow' &&
                        existing().paymentStatus == 'escrow_held' &&
                        incoming().paymentStatus == 'refunded' &&
                        incoming().refundedClientMad == existing().estimatedMad
                      ) || (
                        existing().paymentMethod == 'cash_on_completion' &&
                        incoming().paymentStatus == existing().paymentStatus &&
                        incoming().refundedClientMad == 0
                      )
                    ) &&
                    incoming().diff(existing()).affectedKeys().hasOnly([
                      'status',
                      'paymentStatus',
                      'providerPayoutMad',
                      'platformFeeMad',
                      'refundedClientMad',
                      'cancellationReason',
                      'cancelledBy',
                      'updatedAt'
                    ])
                  ) ||
                  // Action 3: Client or Provider reschedules a pending or accepted booking
                  (
                    (request.auth.uid == existing().clientId || request.auth.uid == existing().providerId) &&
                    (existing().status == 'pending' || existing().status == 'accepted') &&
                    incoming().status == existing().status &&
                    incoming().diff(existing()).affectedKeys().hasOnly([
                      'preferredDate',
                      'preferredTimeSlot',
                      'rescheduleNote',
                      'updatedAt'
                    ])
                  ) ||
                  // Action 4: Client submits 1-5 star review on completed booking (atomically creating /reviews/{bookingId}; no payment tampering)
                  (
                    request.auth.uid == existing().clientId &&
                    existing().status == 'completed' &&
                    incoming().status == 'reviewed' &&
                    incoming().diff(existing()).affectedKeys().hasOnly([
                      'status',
                      'reviewRating',
                      'reviewComment',
                      'updatedAt'
                    ]) &&
                    existsAfter(/databases/$(database)/documents/reviews/$(bookingId))
                  ) ||
                  // Action 5a: Provider accepts a pending booking (status only)
                  (
                    request.auth.uid == existing().providerId &&
                    existing().status == 'pending' &&
                    incoming().status == 'accepted' &&
                    incoming().diff(existing()).affectedKeys().hasOnly([
                      'status',
                      'updatedAt'
                    ])
                  ) ||
                  // Action 5b: Provider declines/cancels a pending or accepted booking (auto-refunds CMI escrow)
                  (
                    request.auth.uid == existing().providerId &&
                    (existing().status == 'pending' || existing().status == 'accepted') &&
                    incoming().status == 'cancelled' &&
                    incoming().cancelledBy == 'provider' &&
                    incoming().providerPayoutMad == 0 &&
                    incoming().platformFeeMad == 0 &&
                    (
                      (
                        existing().paymentMethod == 'cmi_escrow' &&
                        existing().paymentStatus == 'escrow_held' &&
                        incoming().paymentStatus == 'refunded' &&
                        incoming().refundedClientMad == existing().estimatedMad
                      ) || (
                        existing().paymentMethod == 'cash_on_completion' &&
                        incoming().paymentStatus == existing().paymentStatus &&
                        incoming().refundedClientMad == 0
                      )
                    ) &&
                    incoming().diff(existing()).affectedKeys().hasOnly([
                      'status',
                      'paymentStatus',
                      'providerPayoutMad',
                      'platformFeeMad',
                      'refundedClientMad',
                      'cancellationReason',
                      'cancelledBy',
                      'updatedAt'
                    ])
                  ) ||
                  // Action 6: Provider starts an accepted booking (status only)
                  (
                    request.auth.uid == existing().providerId &&
                    existing().status == 'accepted' &&
                    incoming().status == 'in_progress' &&
                    incoming().diff(existing()).affectedKeys().hasOnly([
                      'status',
                      'updatedAt'
                    ])
                  ) ||
                  // Action 7: Provider marks an in_progress booking completed (COD settles to paid; CMI escrow stays escrow_held)
                  (
                    request.auth.uid == existing().providerId &&
                    existing().status == 'in_progress' &&
                    incoming().status == 'completed' &&
                    (
                      (existing().paymentMethod == 'cash_on_completion' && incoming().paymentStatus == 'paid') ||
                      (existing().paymentMethod == 'cmi_escrow' && incoming().paymentStatus == existing().paymentStatus)
                    ) &&
                    incoming().diff(existing()).affectedKeys().hasOnly([
                      'status',
                      'paymentStatus',
                      'updatedAt'
                    ])
                  )
                )
              )
            )
          )
        );

      allow delete: if isVerifiedUser() && isValidId(bookingId) && isAdmin();
    }

    // 16. Match: /chats/{bookingId}/messages/{messageId} (Authorized via parent booking; prevents spoofing & fixes list queries)
    match /chats/{bookingId}/messages/{messageId} {
      allow get: if isVerifiedUser() &&
        isValidId(bookingId) &&
        isValidId(messageId) && (
          get(/databases/$(database)/documents/bookings/$(bookingId)).data.clientId == request.auth.uid ||
          get(/databases/$(database)/documents/bookings/$(bookingId)).data.providerId == request.auth.uid ||
          isAdmin()
        );

      allow list: if isVerifiedUser() &&
        isValidId(bookingId) && (
          get(/databases/$(database)/documents/bookings/$(bookingId)).data.clientId == request.auth.uid ||
          get(/databases/$(database)/documents/bookings/$(bookingId)).data.providerId == request.auth.uid ||
          isAdmin()
        );

      allow create: if isVerifiedUser() &&
        isValidId(bookingId) &&
        isValidId(messageId) &&
        isValidChatMessage(incoming()) &&
        incoming().bookingId == bookingId &&
        incoming().createdAt == request.time &&
        exists(/databases/$(database)/documents/bookings/$(bookingId)) &&
        incoming().clientId == get(/databases/$(database)/documents/bookings/$(bookingId)).data.clientId &&
        incoming().providerId == get(/databases/$(database)/documents/bookings/$(bookingId)).data.providerId && (
          (
            get(/databases/$(database)/documents/bookings/$(bookingId)).data.clientId == request.auth.uid &&
            incoming().senderRole == 'client'
          ) || (
            get(/databases/$(database)/documents/bookings/$(bookingId)).data.providerId == request.auth.uid &&
            incoming().senderRole == 'provider'
          )
        );

      allow update, delete: if false;
    }

    // 17. Match: /adminLogs/{logId} (Append-only immutable audit trail for verified administrators)
    match /adminLogs/{logId} {
      allow get: if isValidId(logId) && isAdmin();
      allow list: if isAdmin();

      allow create: if isAdmin() &&
        isValidId(logId) &&
        isValidAdminLog(incoming()) &&
        incoming().createdAt == request.time;

      allow update, delete: if false;
    }

    // 18. Match: /withdrawals/{withdrawalId} (Registered providers can request withdrawals respecting KYC & min thresholds; admins manage status)
    match /withdrawals/{withdrawalId} {
      allow get: if isVerifiedUser() &&
        isValidId(withdrawalId) &&
        (existing().providerId == request.auth.uid || isAdmin());

      allow list: if (isVerifiedUser() && resource.data.providerId == request.auth.uid) || isAdmin();

      allow create: if isVerifiedUser() &&
        isValidId(withdrawalId) &&
        isValidWithdrawal(incoming()) &&
        incoming().status == 'pending' &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time && (
          isAdmin() || (
            incoming().providerId == request.auth.uid &&
            exists(/databases/$(database)/documents/providers/$(request.auth.uid)) &&
            (
              !exists(/databases/$(database)/documents/systemSettings/global) || (
                incoming().amountMad >= get(/databases/$(database)/documents/systemSettings/global).data.minWithdrawalMad &&
                (
                  !get(/databases/$(database)/documents/systemSettings/global).data.requireKycForEscrowPayout ||
                  get(/databases/$(database)/documents/providers/$(request.auth.uid)).data.verifiedBadge == true
                )
              )
            )
          )
        );

      allow update: if isAdmin() &&
        isValidId(withdrawalId) &&
        isValidWithdrawal(incoming()) &&
        incoming().providerId == existing().providerId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time;

      allow delete: if isAdmin() && isValidId(withdrawalId);
    }

    // 19. Match: /systemSettings/{configId} (Authenticated users read; verified administrators write)
    match /systemSettings/{configId} {
      allow get: if isSignedIn() && isValidId(configId);
      allow list: if isAdmin();

      allow create, update: if isAdmin() &&
        isValidId(configId) &&
        isValidSystemSettings(incoming()) &&
        incoming().updatedAt == request.time;

      allow delete: if false;
    }
  }
}
