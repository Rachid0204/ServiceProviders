# ==============================================================================
# Moul L'Khedma (مول الخدمة) — Environment Variables Configuration
# Firebase Project ID: serviceproviders-530c4
# ==============================================================================

# Server Port (Google Cloud Run injects PORT=8080 by default in production)
PORT="8080"

# APP_URL: The URL where this applet is hosted on Cloud Run.
APP_URL="MY_APP_URL"

# GEMINI_API_KEY: Optional server-side Gemini API key (injected by AI Studio).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# ------------------------------------------------------------------------------
# Firebase Client SDK Configuration (Vite environment variables)
# If omitted, src/firebase.ts falls back to firebase-applet-config.json or safe
# placeholder strings for local/CI builds.
# ------------------------------------------------------------------------------
VITE_FIREBASE_API_KEY="YOUR_FIREBASE_API_KEY"
VITE_FIREBASE_AUTH_DOMAIN="serviceproviders-530c4.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="serviceproviders-530c4"
VITE_FIREBASE_STORAGE_BUCKET="serviceproviders-530c4.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="YOUR_FIREBASE_MESSAGING_SENDER_ID"
VITE_FIREBASE_APP_ID="YOUR_FIREBASE_APP_ID"
VITE_FIREBASE_FIRESTORE_DATABASE_ID="ai-studio-721fde67-a110-4e25-bcc2-2f011a526460"
VITE_FIREBASE_MEASUREMENT_ID=""

# Optional CMI Online Escrow Gateway Credentials (server-side only on Cloud Run)
CMI_MERCHANT_ID=""
CMI_STORE_KEY=""
